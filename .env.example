# Para o .env.dev ->
# AMBIENTE_PROCESSO=desenvolvimento

# Para o .env ->
# AMBIENTE_PROCESSO=producao

# Configurações de conexão com o banco de dados
DB_HOST= 'localhost'
DB_DATABASE= 'infratech'
DB_USER= 'seu_usuario'
DB_PASSWORD= 'sua_senha'
DB_PORT= 3306

# Configurações do servidor de aplicação
APP_PORT=8080
APP_HOST='localhost'

# Bucket S3
S3_BUCKET='nome_bucket'

# Dash geral: origem do JSON gold
# DASH_GOLD_LOCAL=1 lê 03-gold/empresa-{id}/dash-geral.json a partir da raiz do projeto
# S3 usa S3_BUCKET + S3_GOLD_PREFIX: s3://<S3_BUCKET>/<S3_GOLD_PREFIX>/empresa-{id}/dash-geral.json
DASH_GOLD_LOCAL=0
S3_GOLD_PREFIX=03-gold/

# ============================================================
# AWS / S3 - credenciais OPCIONAIS
# Na EC2/Lambda com IAM Role: deixe as credenciais comentadas; o SDK usa a role.
# Fora da AWS: use UMA das duas formas abaixo.
# Nunca preencha só AWS_ACCESS_KEY_ID sem AWS_SECRET_ACCESS_KEY.
# ------------------------------------------------------------
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# Forma 1: credenciais diretas (SESSION_TOKEN só se vier de STS)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Forma 2: perfil compartilhado (~/.aws/credentials e ~/.aws/config)
# AWS_PROFILE=
# AWS_SHARED_CREDENTIALS_FILE=
# AWS_CONFIG_FILE=

# Jira (somente leitura) — cards de incidentes da Dashboard Geral.
# Sem credenciais, as rotas continuam respondendo com estrutura vazia.
# JIRA_API_PATH e JIRA_TIMEOUT_MS são opcionais (defaults abaixo).
# JIRA_BASE_URL=https://sua-instancia.atlassian.net
# JIRA_EMAIL=usuario@empresa.com
# JIRA_TOKEN=token_da_api
# JIRA_PROJECT=INFRA
# JIRA_API_PATH=/rest/api/3/search/jql
# JIRA_TIMEOUT_MS=5000

# importante: caso sua senha contenha caracteres especiais, insira-a entre 'aspas'